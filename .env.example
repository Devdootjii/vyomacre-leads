# Copy this file to .env.local for local testing, and add the same
# two variables in Vercel -> Project -> Settings -> Environment Variables.

# Neon Postgres connection string (same database as the main VyomAcre app)
DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Any long random string. Used by /admin to read the leads list.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=change-this-to-a-long-random-string
